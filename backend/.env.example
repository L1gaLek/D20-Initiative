# Development only. Supply real values locally or through the host environment.
# Do not connect a local test server to production by default.
PORT=8080
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/d20_dev
APP_AUTH_SECRET=REPLACE_WITH_A_RANDOM_DEVELOPMENT_SECRET
AUTH_TOKEN_TTL_DAYS=365
ALLOW_LEGACY_USER_ID_BOOTSTRAP=0
ALLOW_LEGACY_CHARACTER_MIGRATION=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_APP_CORS=1
ENABLE_APP_CORS_ORIGIN=1
TRUST_PROXY_HOPS=0
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
